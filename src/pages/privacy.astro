---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

/**
 * This policy describes what the site actually does today: a static site with
 * no forms, no accounts and no cookies of its own. It MUST be revisited when a
 * contact form, newsletter signup or online giving is added.
 */
const lastUpdated = '14 September 2026';
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${site.name} handles personal information on this website.`}
>
  <PageHero eyebrow="Privacy" title="Privacy Policy" />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="prose-measure leading-relaxed text-ink">
      <p class="text-sm text-ink-muted">Last updated: {lastUpdated}</p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        In short
      </h2>
      <p class="mt-3">
        This website does not ask you for personal information, does not create
        accounts, and does not set cookies of its own. You can read every page
        without telling us anything about yourself.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Who we are
      </h2>
      <p class="mt-3">
        {site.name}, {site.address.full}, {site.address.country}.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        What we collect
      </h2>
      <p class="mt-3">
        We collect aggregate, anonymous statistics about how the site is used —
        such as which pages are visited and roughly which country visitors come
        from. This is measured without cookies and without tracking individuals
        across sites, and it cannot be used to identify you.
      </p>
      <p class="mt-3">
        Our web host keeps standard server logs, which may include IP addresses,
        for security and reliability purposes.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Third-party content
      </h2>
      <p class="mt-3">
        The <a href="/visit" class="text-blue-700 underline underline-offset-4">Visit Us</a>
        page embeds a map provided by Google. When that map loads, Google may
        receive information about your visit and may set its own cookies, under
        Google&rsquo;s privacy policy rather than ours. Web fonts are loaded from
        Google Fonts.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        What we do not do
      </h2>
      <ul class="mt-3 list-disc space-y-2 pl-6">
        <li>We do not sell or share personal information.</li>
        <li>We do not run advertising or advertising trackers.</li>
        <li>We do not build profiles of visitors.</li>
        <li>We do not send marketing email from this website.</li>
      </ul>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Information you give us in person
      </h2>
      <p class="mt-3">
        If you give your contact details to us at church — for example on a
        welcome card or a prayer request — we use them only for the purpose you
        gave them, and we do not publish them. You can ask us to correct or
        delete them at any time.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Photographs
      </h2>
      <p class="mt-3">
        We seek consent before publishing photographs in which individuals are
        identifiable, and we take particular care with images of children. If a
        photograph of you or your child appears on this site and you would like
        it removed, please contact us and we will remove it.
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Your rights
      </h2>
      <p class="mt-3">
        You may ask what personal information we hold about you, ask us to
        correct it, or ask us to delete it. We handle personal information in
        line with the Australian Privacy Principles under the
        <em>Privacy Act 1988</em> (Cth).
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Contact
      </h2>
      <p class="mt-3">
        {site.contact.email ? (
          <>
            Questions about this policy can be sent to{' '}
            <a href={`mailto:${site.contact.email}`} class="text-blue-700 underline underline-offset-4">
              {site.contact.email}
            </a>.
          </>
        ) : (
          <>
            Questions about this policy can be raised with Pastor Daniel or one
            of the leaders at church.
          </>
        )}
      </p>

      <h2 class="mt-10 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
        Changes
      </h2>
      <p class="mt-3">
        If this website changes — for example if we add a contact form or online
        giving — we will update this policy and the date at the top of this page.
      </p>
    </div>
  </section>
</BaseLayout>
