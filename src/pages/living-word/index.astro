---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Scripture from '../../components/Scripture.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { site } from '../../data/site';
import { getLatestMessage, getMessageArchive } from '../../lib/content';
import { renderMessageBody, messageExcerpt } from '../../lib/portabletext';
import { formatDate } from '../../lib/datetime';

const latest = await getLatestMessage();
const archive = await getMessageArchive();

const bodyHtml = renderMessageBody(latest?.body);
const description = latest
  ? messageExcerpt(latest.body) || `${latest.title} — this week's message from ${latest.author ?? site.pastor.name}.`
  : 'A weekly message from Pastor Daniel at El Shaddai Living Waters Church, Whalan — the Word of God for your week.';
---

<BaseLayout title="Living Word" description={description}>
  <PageHero
    eyebrow="Living Word"
    title="A word for this week"
    lede={`A message published each week by ${site.pastor.name} — to read, reflect on, and carry with you through the week.`}
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    {latest ? (
      <div class="grid gap-14 lg:grid-cols-[minmax(0,1.5fr)_1fr] lg:gap-16">
        <article>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-600">
            <time datetime={latest.publishDate}>{formatDate(latest.publishDate)}</time>
            {latest.series && <> · {latest.series}</>}
          </p>

          <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold text-blue-900 sm:text-4xl">
            {latest.title}
          </h2>

          {latest.passage && (
            <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-gold-500/45 px-4 py-1.5 text-sm font-semibold text-gold-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5v-15ZM4 20.5A2.5 2.5 0 0 1 6.5 18H19v3H6.5A2.5 2.5 0 0 1 4 20.5Z"
                  stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
              {latest.passage}
            </p>
          )}

          {latest.summary && (
            <p class="prose-measure mt-6 text-lg leading-relaxed text-ink-muted">
              {latest.summary}
            </p>
          )}

          {bodyHtml && (
            <div class="prose-measure mt-8 text-[1.06rem]" set:html={bodyHtml} />
          )}

          <p class="mt-10 border-t border-gold-500/30 pt-6 text-sm text-ink-muted">
            {latest.author ?? site.pastor.name} · {site.pastor.role}
          </p>

          {latest.attachmentUrl && (
            <a
              href={latest.attachmentUrl}
              class="mt-6 inline-flex items-center gap-2 rounded-lg border border-blue-900/25 px-5 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-blue-900/5"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Download study notes
            </a>
          )}
        </article>

        {archive.length > 0 && (
          <aside class="lg:sticky lg:top-24 lg:self-start">
            <div class="rounded-xl border border-gold-500/30 bg-surface p-6 shadow-sm">
              <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">
                Previous weeks
              </h2>
              <ul class="mt-4 space-y-4">
                {archive.map((m) => (
                  <li class="border-t border-gold-500/20 pt-4 first:border-0 first:pt-0">
                    <a
                      href={`/living-word/${m.slug}`}
                      class="group block no-underline"
                    >
                      <p class="font-medium text-blue-900 group-hover:underline underline-offset-4">
                        {m.title}
                      </p>
                      <p class="mt-0.5 text-xs text-ink-muted">
                        <time datetime={m.publishDate}>{formatDate(m.publishDate)}</time>
                        {m.passage && <> · {m.passage}</>}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gold-500/45 bg-surface p-10 text-center">
        <p class="font-[family-name:var(--font-display)] text-xl text-blue-900">
          This week&rsquo;s word will be published shortly
        </p>
        <p class="prose-measure mx-auto mt-3 leading-relaxed text-ink-muted">
          Each week {site.pastor.name} posts a message here — a passage to read
          and teaching to reflect on through the week. Do come back, or join us
          on a Sunday to hear the Word preached.
        </p>
      </div>
    )}
  </section>

  <WaveDivider />

  <section class="bg-blue-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading
        eyebrow="Why We Do This"
        title="From spiritual infancy into maturity"
        tone="dark"
      />
      <div class="prose-measure mt-8">
        <p class="text-lg leading-relaxed text-white/90">
          One of the six pillars of our mission is discipleship — helping
          believers grow from spiritual infancy into maturity. The Living Word
          exists so that Scripture is not only heard on Sunday, but carried into
          the week and read for yourself.
        </p>
        <Scripture reference="Matthew 28:19–20" tone="dark">
          Go and make disciples of all nations … teaching them to obey
          everything I have commanded you.
        </Scripture>
      </div>
      <a
        href="/weekly-program"
        class="mt-4 inline-flex rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
      >
        See this Sunday&rsquo;s program
      </a>
    </div>
  </section>
</BaseLayout>
