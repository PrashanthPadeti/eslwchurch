---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Scripture from '../components/Scripture.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { site } from '../data/site';
import { getUpcomingBibleStudies, getPastBibleStudies } from '../lib/content';
import { formatDateTime, formatDate, relativeDayLabel } from '../lib/datetime';

const upcoming = await getUpcomingBibleStudies();
const past = await getPastBibleStudies();
const next = upcoming[0];
const rest = upcoming.slice(1);
---

<BaseLayout
  title="Weekly Bible Study"
  description="Weekly Bible study at El Shaddai Living Waters Church, Whalan — growing together in the Word of God. Everyone is welcome, wherever you are in your walk with Jesus."
>
  <PageHero
    eyebrow="Weekly Bible Study"
    title="Growing together in the Word"
    lede="A time to open the Bible together, ask honest questions, and help one another grow from spiritual infancy into maturity."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    {next ? (
      <>
        <SectionHeading eyebrow="Next Study" title={next.title} />

        <div class="mt-8 grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
          <div>
            {next.series && (
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">
                Part of {next.series}
              </p>
            )}

            <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
              <div class="border-t border-gold-500/30 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">When</dt>
                <dd class="mt-1.5 font-medium text-blue-900">
                  <time datetime={next.date}>{formatDateTime(next.date)}</time>
                  {relativeDayLabel(next.date) && (
                    <span class="ml-1 text-blue-700">({relativeDayLabel(next.date)})</span>
                  )}
                </dd>
              </div>
              {next.passage && (
                <div class="border-t border-gold-500/30 pt-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Passage</dt>
                  <dd class="mt-1.5 font-medium text-blue-700">{next.passage}</dd>
                </div>
              )}
              {next.leader && (
                <div class="border-t border-gold-500/30 pt-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Led by</dt>
                  <dd class="mt-1.5 font-medium text-blue-900">{next.leader}</dd>
                </div>
              )}
              {(next.venue ?? site.address.full) && (
                <div class="border-t border-gold-500/30 pt-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Where</dt>
                  <dd class="mt-1.5 font-medium text-blue-900">
                    {next.venue ?? site.address.full}
                  </dd>
                </div>
              )}
            </dl>

            {next.description && (
              <p class="prose-measure mt-8 text-lg leading-relaxed text-ink">
                {next.description}
              </p>
            )}

            <div class="mt-8 flex flex-wrap gap-3">
              {next.onlineLink && (
                <a
                  href={next.onlineLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex rounded-lg bg-gold-500 px-5 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
                >
                  Join online
                </a>
              )}
              {next.notesUrl && (
                <a
                  href={next.notesUrl}
                  class="inline-flex rounded-lg border border-blue-900/25 px-5 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-blue-900/5"
                >
                  Download study notes
                </a>
              )}
              <a
                href={site.mapsLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-lg border border-blue-900/25 px-5 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-blue-900/5"
              >
                Get directions
              </a>
            </div>
          </div>

          {rest.length > 0 && (
            <div class="rounded-xl border border-gold-500/30 bg-surface p-6 shadow-sm lg:self-start">
              <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">
                Also coming up
              </h2>
              <ul class="mt-4 space-y-4">
                {rest.map((s) => (
                  <li class="border-t border-gold-500/20 pt-4 first:border-0 first:pt-0">
                    <p class="font-medium text-blue-900">{s.title}</p>
                    <p class="mt-0.5 text-sm text-blue-700">
                      <time datetime={s.date}>{formatDateTime(s.date)}</time>
                    </p>
                    {s.passage && (
                      <p class="mt-0.5 text-sm text-ink-muted">{s.passage}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </>
    ) : (
      <div class="rounded-xl border border-dashed border-gold-500/45 bg-surface p-10 text-center">
        <p class="font-[family-name:var(--font-display)] text-xl text-blue-900">
          The next Bible study will be posted here soon
        </p>
        <p class="prose-measure mx-auto mt-3 leading-relaxed text-ink-muted">
          Details of each week&rsquo;s passage, who is leading and where we meet
          will appear on this page. In the meantime, speak with Pastor Daniel or
          one of the leaders on a Sunday and they will be glad to tell you when
          the group next meets.
        </p>
      </div>
    )}
  </section>

  <WaveDivider />

  <section class="bg-blue-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading
        eyebrow="Why We Study Together"
        title="From spiritual infancy into maturity"
        tone="dark"
      />
      <div class="prose-measure mt-8">
        <p class="text-lg leading-relaxed text-white/90">
          One of the six pillars of our mission is discipleship — helping
          believers grow from spiritual infancy into maturity. Bible study is
          where much of that growth actually happens: not only hearing the Word
          preached on Sunday, but opening it together, asking questions, and
          learning to read it for ourselves.
        </p>
        <p class="mt-5 leading-relaxed text-white/85">
          You do not need to know the Bible well to come. You do not need to
          have anything to say. Come and listen, and grow at your own pace.
        </p>
        <Scripture reference="Matthew 28:19–20" tone="dark">
          Go and make disciples of all nations … teaching them to obey
          everything I have commanded you.
        </Scripture>
      </div>

      <a
        href="/whats-on"
        class="mt-4 inline-flex rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
      >
        See everything that&rsquo;s on
      </a>
    </div>
  </section>

  {past.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading eyebrow="Archive" title="Studies we have worked through" />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {past.map((s) => (
          <li class="rounded-xl border border-gold-500/25 bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">
              {formatDate(s.date)}
            </p>
            <p class="mt-2 font-medium text-blue-900">{s.title}</p>
            {s.passage && <p class="mt-1 text-sm text-blue-700">{s.passage}</p>}
            {s.notesUrl && (
              <a
                href={s.notesUrl}
                class="mt-3 inline-flex text-sm font-semibold text-blue-700 underline underline-offset-4"
              >
                Study notes
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
