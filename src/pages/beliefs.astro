---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Scripture from '../components/Scripture.astro';
import WaveDivider from '../components/WaveDivider.astro';

/**
 * This page is built entirely from material the church supplied. It presents
 * convictions and emphases, not a formal doctrinal statement — a full statement
 * of faith is still to be provided. See docs/CONTENT-MAP.md section 5.
 */

const convictions = [
  {
    title: 'God Almighty',
    text: 'God is our source, our strength, our provider and our refuge. This church belongs to God, and everything we do must depend on Him.',
    ref: 'Genesis 17:1',
  },
  {
    title: 'Jesus Christ',
    text: 'We preach Jesus Christ, reach the lost, and lead people to salvation. Our vision is to make Him known.',
    ref: 'Mark 16:15',
  },
  {
    title: 'The Word of God',
    text: 'We faithfully teach and preach the Bible, and help believers grow from spiritual infancy into maturity.',
    ref: 'Matthew 28:19–20',
  },
  {
    title: 'The Holy Spirit',
    text: 'We welcome and follow the work of the Holy Spirit, and minister in His power and gifts.',
    ref: 'Acts 1:8',
  },
  {
    title: 'The Church as a Body',
    text: 'Every person has a place, a gift and a responsibility. Church is not a place where one person does everything.',
    ref: '1 Corinthians 12:27',
  },
  {
    title: 'The Return of Christ',
    text: 'We prepare believers to live faithfully and be ready for the return of Jesus Christ.',
    ref: 'Matthew 28:19–20',
  },
];
---

<BaseLayout
  title="What We Believe"
  description="The convictions that shape El Shaddai Living Waters Church: God Almighty, Jesus Christ, the Word of God, the Holy Spirit, the Church as a body, and the return of Christ."
>
  <PageHero
    eyebrow="What We Believe"
    title="A Christ-centred, Spirit-filled church"
    lede="Our name reflects who we believe God is and what we desire to see in His Church."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <ul class="grid gap-8 md:grid-cols-2">
      {convictions.map((c) => (
        <li class="rounded-xl border border-gold-500/30 bg-surface p-7 shadow-sm">
          <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold text-blue-900">
            {c.title}
          </h2>
          <p class="mt-3 leading-relaxed text-ink">{c.text}</p>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">
            {c.ref}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <WaveDivider />

  <section class="bg-blue-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading
        eyebrow="Our Prayer"
        title="Let the Living Waters flow"
        tone="dark"
        align="center"
      />
      <div class="mx-auto mt-10 max-w-2xl text-center">
        <Scripture reference="Ezekiel 47:9" tone="dark">
          Everything will live where the river flows.
        </Scripture>
        <p class="leading-relaxed text-white/85">
          Our desire is to see the living waters of the Holy Spirit flow into
          families, our community and beyond — bringing hope, healing,
          restoration and new life.
        </p>
        <a
          href="/mission-vision"
          class="mt-8 inline-flex rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
        >
          Our mission &amp; vision
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
