---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTimesCard from '../components/ServiceTimesCard.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold-600">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-blue-900 sm:text-4xl">
      We could not find that page
    </h1>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-ink-muted">
      The page may have moved, or the link may be out of date. You are still very
      welcome on Sunday.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
      >
        Back to home
      </a>
      <a
        href="/whats-on"
        class="inline-flex rounded-lg border border-blue-900/25 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-blue-900/5"
      >
        What&rsquo;s on
      </a>
    </div>
    <div class="mx-auto mt-14 max-w-md text-left">
      <ServiceTimesCard variant="panel" showNext={false} />
    </div>
  </section>
</BaseLayout>
