---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceTimesCard from '../components/ServiceTimesCard.astro';
import { site, languageLabel } from '../data/site';
import { getCurrentProgram, getProgramArchive } from '../lib/content';
import { formatWallTime, formatDate, weekdayName } from '../lib/datetime';

const program = await getCurrentProgram();
const archive = await getProgramArchive();
const service = site.services[0];
---

<BaseLayout
  title="Weekly Program"
  description={`This Sunday's order of service at El Shaddai Living Waters Church, Whalan — worship, the Word and prayer, ${weekdayName(service.weekday)}s from ${formatWallTime(service.start)}.`}
>
  <PageHero
    eyebrow="Weekly Program"
    title="This Sunday at El Shaddai"
    lede="What our gathering looks like this week — who is leading, what we are reading, and how the morning runs."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    {program ? (
      <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-600">
            Sunday {formatDate(program.weekOf)}
          </p>

          {program.theme && (
            <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold text-blue-900 sm:text-4xl">
              {program.theme}
            </h2>
          )}

          <!-- The facts someone scans for before deciding to come -->
          <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2">
            {program.sermonTitle && (
              <div class="border-t border-gold-500/30 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Message</dt>
                <dd class="mt-1.5 font-medium text-blue-900">{program.sermonTitle}</dd>
              </div>
            )}
            {program.preacher && (
              <div class="border-t border-gold-500/30 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Speaking</dt>
                <dd class="mt-1.5 font-medium text-blue-900">{program.preacher}</dd>
              </div>
            )}
            {program.scriptureReading && (
              <div class="border-t border-gold-500/30 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Reading</dt>
                <dd class="mt-1.5 font-medium text-blue-700">{program.scriptureReading}</dd>
              </div>
            )}
            {program.worshipLeader && (
              <div class="border-t border-gold-500/30 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-600">Worship</dt>
                <dd class="mt-1.5 font-medium text-blue-900">{program.worshipLeader}</dd>
              </div>
            )}
          </dl>

          {program.communion && (
            <p class="mt-7 inline-flex items-center gap-2 rounded-full border border-gold-500/45 px-4 py-1.5 text-sm font-semibold text-gold-600">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 4h10l-1 7a4 4 0 0 1-8 0L7 4ZM12 15v5M8.5 20h7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Holy Communion this Sunday
            </p>
          )}

          {program.items.length > 0 && (
            <div class="mt-12">
              <SectionHeading eyebrow="Order of Service" title="How the morning runs" />
              <ol class="mt-8">
                {program.items.map((item) => (
                  <li class="grid grid-cols-[4.5rem_1fr] gap-4 border-b border-gold-500/20 py-4 sm:grid-cols-[6rem_1fr] sm:gap-6">
                    <span class="text-sm font-semibold tabular-nums text-gold-600">
                      {item.time ? formatWallTime(item.time) : ''}
                    </span>
                    <span>
                      <span class="block font-medium text-ink">{item.activity}</span>
                      {item.person && (
                        <span class="mt-0.5 block text-sm text-ink-muted">{item.person}</span>
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {program.notes && (
            <div class="mt-10 rounded-xl border-l-3 border-gold-500 bg-surface p-6 shadow-sm">
              <p class="leading-relaxed text-ink">{program.notes}</p>
            </div>
          )}
        </div>

        <div class="lg:sticky lg:top-24 lg:self-start">
          <ServiceTimesCard variant="panel" />

          {archive.length > 0 && (
            <div class="mt-8 rounded-xl border border-gold-500/30 bg-surface p-6 shadow-sm">
              <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">
                Recent Sundays
              </h2>
              <ul class="mt-4 space-y-3.5">
                {archive.map((p) => (
                  <li class="border-t border-gold-500/20 pt-3.5 first:border-0 first:pt-0">
                    <p class="text-sm font-medium text-blue-900">
                      {p.sermonTitle ?? p.theme ?? 'Sunday Worship'}
                    </p>
                    <p class="mt-0.5 text-xs text-ink-muted">
                      {formatDate(p.weekOf)}
                      {p.preacher && <> · {p.preacher}</>}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        <div>
          <div class="rounded-xl border border-dashed border-gold-500/45 bg-surface p-10">
            <p class="font-[family-name:var(--font-display)] text-xl text-blue-900">
              This week&rsquo;s program will be published shortly
            </p>
            <p class="prose-measure mt-3 leading-relaxed text-ink-muted">
              Our Sunday service runs every week regardless — {weekdayName(service.weekday)}s
              from {formatWallTime(service.start)}, a
              {' '}{languageLabel(service)} service of worship, the Word of God and
              prayer. You are welcome to join us whether or not the week&rsquo;s
              running order is up yet.
            </p>
          </div>
        </div>
        <div>
          <ServiceTimesCard variant="panel" />
        </div>
      </div>
    )}
  </section>
</BaseLayout>
