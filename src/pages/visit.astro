---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Scripture from '../components/Scripture.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { site, languageLabel } from '../data/site';
import {
  formatWallTimeRange,
  weekdayName,
  nextOccurrence,
  formatDate,
  relativeDayLabel,
} from '../lib/datetime';

const service = site.services[0];
const next = nextOccurrence(service.weekday, service.start, service.end);
const nextLabel = relativeDayLabel(next);

// Only rendered when the church supplies the detail — see docs/CONTENT-MAP.md.
// Sections with no content simply do not appear, rather than showing a stub.
const practicalities = [
  { label: 'Parking', value: null as string | null },
  { label: 'Public transport', value: null as string | null },
  { label: 'Accessibility', value: null as string | null },
].filter((p) => p.value);
---

<BaseLayout
  title="Visit Us"
  description={`Join us for worship on ${weekdayName(service.weekday)}s, ${formatWallTimeRange(service.start, service.end)}, at ${site.address.full}. Everyone is welcome.`}
>
  <PageHero
    eyebrow="Visit Us"
    title="You are welcome here"
    lede="Come as you are. Whether you have been walking with Jesus for years or are simply curious, there is a place for you on Sunday."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <!-- Details -->
      <div>
        <SectionHeading eyebrow="Service Times" title="When we gather" />

        <div class="mt-8 space-y-6">
          {site.services.map((s) => (
            <div class="rounded-xl border border-gold-500/35 bg-surface p-6 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-600">
                {s.name}
              </p>
              <p class="mt-3 font-[family-name:var(--font-display)] text-2xl font-semibold text-blue-900">
                {weekdayName(s.weekday)}s
              </p>
              <p class="mt-1 text-xl text-blue-700">
                {formatWallTimeRange(s.start, s.end)}
              </p>
              {languageLabel(s) && (
                <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-gold-500/45 px-3 py-1 text-xs font-semibold text-gold-600">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                    <path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  {languageLabel(s)} service
                </p>
              )}
              {s.description && (
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{s.description}</p>
              )}
            </div>
          ))}
        </div>

        <p class="mt-6 text-sm text-ink-muted">
          Next service:{' '}
          <time datetime={next.toISOString()} class="font-semibold text-blue-700">
            {formatDate(next)}
          </time>
          {nextLabel && <span>{' '}({nextLabel})</span>}
        </p>

        <div class="mt-12">
          <SectionHeading eyebrow="Where to find us" title="Our location" />
          <address class="mt-7 not-italic text-lg leading-relaxed text-ink">
            <span class="block font-semibold text-blue-900">{site.address.street}</span>
            {site.address.suburb} {site.address.state} {site.address.postcode}
            <span class="block text-base text-ink-muted">{site.address.country}</span>
          </address>

          <a
            href={site.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="2"/>
            </svg>
            Open in Google Maps
          </a>

          {practicalities.length > 0 && (
            <dl class="mt-10 space-y-5">
              {practicalities.map((p) => (
                <div class="border-t border-gold-500/30 pt-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">
                    {p.label}
                  </dt>
                  <dd class="mt-1.5 leading-relaxed text-ink">{p.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>

        {(site.contact.email || site.contact.phone) && (
          <div class="mt-12">
            <SectionHeading eyebrow="Get in touch" title="Questions before you come?" />
            <ul class="mt-6 space-y-2">
              {site.contact.email && (
                <li>
                  <a href={`mailto:${site.contact.email}`} class="font-semibold text-blue-700 underline underline-offset-4">
                    {site.contact.email}
                  </a>
                </li>
              )}
              {site.contact.phone && (
                <li>
                  <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="font-semibold text-blue-700 underline underline-offset-4">
                    {site.contact.phone}
                  </a>
                </li>
              )}
            </ul>
          </div>
        )}
      </div>

      <!-- Map -->
      <div>
        <div class="overflow-hidden rounded-xl border border-gold-500/35 shadow-sm">
          <iframe
            src={site.mapsEmbed}
            title={`Map showing ${site.name} at ${site.address.full}`}
            width="100%"
            height="520"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="block h-[420px] w-full sm:h-[520px]"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

  <WaveDivider />

  <!-- What to expect -->
  <section class="bg-blue-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHeading
        eyebrow="Your First Visit"
        title="What to expect"
        tone="dark"
      />

      <div class="prose-measure mt-8 text-[1.06rem] leading-[1.75]">
        <p class="text-white/90">
          Our Sunday gathering is a time to worship God, hear His Word, pray
          together, share in Holy Communion, and grow as a church family.
        </p>
        <p class="mt-5 text-white/90">
          You can expect heartfelt worship, biblical preaching, prayer, and a
          warm, welcoming community. Come just as you are — there is no dress
          code, no pressure, and no need to feel nervous or out of place.
        </p>
        <p class="mt-5 text-white/90">
          If it is your first time with us, simply let one of our team members
          know when you arrive. We would love to welcome you, help you feel at
          home, and introduce you to our church family.
        </p>
        <p class="mt-5 text-gold-100">
          At El Shaddai Living Waters Church, you are not just attending a
          service — you are invited to become part of a loving community where we
          worship, grow, pray, serve, and walk together in Christ.
        </p>

        <Scripture reference="Romans 15:7" tone="dark">
          Welcome one another as Christ has welcomed you.
        </Scripture>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={site.mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-gold-500 px-6 py-3 text-sm font-semibold text-blue-900 no-underline transition-colors hover:bg-gold-300"
        >
          Get directions
        </a>
        <a
          href="/belonging"
          class="inline-flex rounded-lg border border-white/35 px-6 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-white/10"
        >
          What belonging means here
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
