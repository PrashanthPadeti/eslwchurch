---
import { site } from '../data/site';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/mission-vision', label: 'Mission & Vision' },
  { href: '/whats-on', label: "What's On" },
  { href: '/visit', label: 'Visit' },
  { href: '/give', label: 'Give' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-gold-500/25 bg-ground/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:px-6">
    <!-- The emblem is illegible below ~64px, so it is always paired with the
         typeset wordmark rather than standing alone. See docs/BRAND.md -->
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={`${site.name} — home`}>
      <img
        src="/logo-128.webp"
        alt=""
        width="56"
        height="56"
        class="h-12 w-12 shrink-0 sm:h-14 sm:w-14"
        fetchpriority="high"
      />
      <span class="flex flex-col leading-none">
        <span class="font-[family-name:var(--font-display)] text-[0.95rem] font-semibold tracking-tight text-blue-900 sm:text-lg">
          El Shaddai Living Waters
        </span>
        <span class="mt-0.5 text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-gold-600 sm:text-[0.68rem]">
          Church · Sydney
        </span>
      </span>
    </a>

    <nav class="ml-auto hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded px-3 py-2 text-[0.95rem] font-medium no-underline transition-colors',
                isActive(item.href)
                  ? 'bg-blue-900 text-white'
                  : 'text-blue-900 hover:bg-blue-900/8',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="navToggle"
      type="button"
      class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded border border-blue-900/20 text-blue-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobileNav"
    >
      <span class="sr-only">Menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobileNav" hidden class="border-t border-gold-500/25 lg:hidden" aria-label="Primary mobile">
    <ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block rounded px-3 py-3 text-base font-medium no-underline',
              isActive(item.href) ? 'bg-blue-900 text-white' : 'text-blue-900',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
