---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="bg-blue-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    {eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-300">{eyebrow}</p>
    )}
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl md:text-5xl">{title}</h1>
    {lede && (
      <p class="prose-measure mt-5 text-lg leading-relaxed text-white/85">{lede}</p>
    )}
  </div>
</section>
